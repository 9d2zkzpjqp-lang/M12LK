<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mathe-LK – Musterlösungen</title>
  <style>
    :root {
      --bg: #f5f7fa;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #d1d5db;
      --accent: #1d4ed8;
      --accent-hover: #1e40af;
      --shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
      --radius: 14px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 16px 40px;
    }

    header {
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(1.6rem, 2.5vw, 2.4rem);
      margin: 0 0 8px;
    }

    .subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 0.98rem;
    }

    .controls {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin: 20px 0 24px;
    }

    button {
      appearance: none;
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #fff;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.98rem;
      font-weight: 600;
      cursor: pointer;
    }

    button:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
    }

    .accordion {
      display: grid;
      gap: 14px;
    }

    .accordion-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .accordion-item summary {
      list-style: none;
      cursor: pointer;
      padding: 16px 18px;
      font-size: 1.05rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .accordion-item summary::-webkit-details-marker {
      display: none;
    }

    .accordion-item summary::after {
      content: '▾';
      margin-left: auto;
      color: var(--muted);
      transition: transform 0.15s ease;
      font-size: 1rem;
    }

    .accordion-item[open] summary::after {
      transform: rotate(180deg);
    }

    .accordion-content {
      padding: 0 18px 18px;
      border-top: 1px solid var(--border);
    }

    .accordion-content img {
      display: block;
      width: 100%;
      height: auto;
      margin-top: 16px;
      border-radius: 10px;
      background: #fff;
    }

    footer {
      margin-top: 24px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    @media (max-width: 640px) {
      .container {
        padding: 16px 12px 28px;
      }
      .accordion-item summary {
        padding: 14px 15px;
        font-size: 1rem;
      }
      .accordion-content {
        padding: 0 12px 12px;
      }
      button {
        width: 100%;
      }
      .controls {
        display: grid;
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="container">
    <header>
      <h1>Mathe-LK – Musterlösungen</h1>
      <p class="subtitle">Seite 26 · Aufgaben 1–4</p>
    </header>

    <div class="controls" aria-label="Steuerung für alle Accordions">
      <button type="button" id="openAll">Alle öffnen</button>
      <button type="button" id="closeAll">Alle schließen</button>
    </div>

    <section class="accordion" aria-label="Musterlösungen">
      
    <details class="accordion-item">
      <summary>Seite 26 | Aufgabe 1</summary>
      <div class="accordion-content">
        <img src="data:image/jpeg;base64," alt="Seite 26 | Aufgabe 1" loading="lazy">
      </div>
    </details>
    <details class="accordion-item">
      <summary>Seite 26 | Aufgabe 2</summary>
      <div class="accordion-content">
        <img src="data:image/jpeg;base64," alt="Seite 26 | Aufgabe 2" loading="lazy">
      </div>
    </details>
    <details class="accordion-item">
      <summary>Seite 26 | Aufgabe 3</summary>
      <div class="accordion-content">
        <img src="data:image/jpeg;base64," alt="Seite 26 | Aufgabe 3" loading="lazy">
      </div>
    </details>
    <details class="accordion-item">
      <summary>Seite 26 | Aufgabe 4</summary>
      <div class="accordion-content">
        <img src="data:image/jpeg;base64," alt="Seite 26 | Aufgabe 4" loading="lazy">
      </div>
    </details>
    </section>

    <footer>
      Eigenständige HTML-Datei mit eingebetteten Bildern (Base64/Data-URI), geeignet für GitHub Pages.
    </footer>
  </main>

  <script>
    (function () {
      const detailsList = Array.from(document.querySelectorAll('.accordion-item'));
      const openAllBtn = document.getElementById('openAll');
      const closeAllBtn = document.getElementById('closeAll');

      openAllBtn.addEventListener('click', function () {
        detailsList.forEach(item => item.open = true);
      });

      closeAllBtn.addEventListener('click', function () {
        detailsList.forEach(item => item.open = false);
      });
    })();
  </script>
</body>
</html>
